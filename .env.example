FQ_ENV=development
FQ_LOG_LEVEL=INFO
FQ_DATABASE_URL=sqlite:///./franquestions.db
FQ_API_URL=http://localhost:8000

# La API SDDE del BCCR requiere registro y un token generado en Mi perfil.
FQ_BCCR_NAME=
FQ_BCCR_EMAIL=
FQ_BCCR_TOKEN=
FQ_BCCR_BASE_URL=https://apim.bccr.fi.cr/SDDE/api/Bccr.Ge.SDDE.Publico.Indicadores.API

# Use solamente una URL oficial de INEC con estructura CSV conocida.
FQ_INEC_DATA_URL=
FQ_HTTP_TIMEOUT_SECONDS=30
